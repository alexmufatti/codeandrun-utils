MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/codeandrun
NEXTAUTH_URL=http://localhost:3000
NEXTAUTH_SECRET=<genera-con: openssl rand -base64 32>
GOOGLE_CLIENT_ID=<google-oauth-client-id>
GOOGLE_CLIENT_SECRET=<google-oauth-client-secret>
STRAVA_CLIENT_ID=<strava-app-client-id>
STRAVA_CLIENT_SECRET=<strava-app-client-secret>
STRAVA_VERIFY_TOKEN=<stringa-casuale-per-verifica-webhook>
PROCESS_QUEUE_SECRET=<stringa-casuale-per-autenticare-il-cron>
G_STATICMAP_KEY=<google-static-maps-api-key>

# AWS / S3 (per create draft MDX e aggiornamento statistiche Running)
AWS_ACCESS_KEY_ID=<aws-access-key-id>
AWS_SECRET_ACCESS_KEY=<aws-secret-access-key>
AWS_REGION=eu-south-1
S3_BUCKET=codeandrun-wordpress
CDN_URL=https://cdn.codeandrun.it
